# Runtime
AI_ENVIRONMENT=development
AI_LOG_LEVEL=INFO
AI_CORS_ALLOWED_ORIGINS=*
AI_AUTH_MODE=static
AI_STATIC_TOKENS=replace-with-a-long-random-local-token

# DeepSeek (server-side only; never put this key in the Electron application)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_ALLOWED_MODELS=deepseek-flash,deepseek-v4-pro
AI_DEFAULT_MODEL=deepseek-flash
AI_MAX_OUTPUT_TOKENS=32768
AI_MAX_REQUEST_BYTES=4194304

# JWT mode (used after the CloudBase identity service is available)
AI_JWT_PUBLIC_KEY_FILE=
AI_JWT_ISSUER=jj-office-cloudbase
AI_JWT_AUDIENCE=jj-office-ai

# Optional distributed rate limiter. Leave blank for an in-memory limiter in local development.
AI_REDIS_URL=
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AI_MAX_CONCURRENT_REQUESTS_PER_USER=3

# CloudBase quota service. The token must equal OFFICE_INTERNAL_SERVICE_TOKEN.
AI_QUOTA_SERVICE_URL=https://seekservice-9gkeeztlfcb2a6d4-1301441002.ap-shanghai.app.tcloudbase.com/chat-router-server
AI_QUOTA_SERVICE_TOKEN=
AI_QUOTA_TIMEOUT_SECONDS=15
